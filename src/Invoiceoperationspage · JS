const derive = (sc) => {
  const inv = sc.invoice;
  const subtotal = inv.qty * inv.unit;
  const tax = Math.round(subtotal * 0.15 * 100) / 100;
  const poTotal = sc.po.qty * sc.po.unit;
  const overUnits = inv.qty - sc.grn.qty;
  return {
    subtotal,
    tax,
    total: subtotal + tax,
    poTotal,
    mismatch: overUnits > 0,
    overUnits,
    overAmount: overUnits * inv.unit,
  };
};

const fieldsOf = (sc) => {
  const d = derive(sc);
  const inv = sc.invoice;
  return [
    ["Vendor", sc.vendor],
    ["Invoice number", inv.number],
    ["Invoice date", inv.date],
    ["Payment terms", `${inv.terms}, due ${inv.due}`],
    ["PO number", inv.po],
    ["Quantity", String(inv.qty)],
    ["Unit price", money(inv.unit)],
    ["Subtotal", money(d.subtotal)],
    ["Tax (15%)", money(d.tax)],
    ["Total", money(d.total)],
  ];
};


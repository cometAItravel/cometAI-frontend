/* ─── PIECES ──────────────────────────────────────────────────────────────── */
function Hl({ on, children }) {
  return <span className={"io-hl" + (on ? " on" : "")}>{children}</span>;
}

function InvoiceDoc({ sc, d, extracted, flagged }) {
  const inv = sc.invoice;
  return (
    <div className="io-paper" aria-label={`Sample invoice ${inv.number}`}>
      <div className="vendor">{sc.vendor}</div>
      <div className="doc-title">
        Invoice <Hl on={extracted}>{inv.number}</Hl>
      </div>
      <dl>
        <dt>Invoice date</dt>
        <dd><Hl on={extracted}>{inv.date}</Hl></dd>
        <dt>Payment terms</dt>
        <dd><Hl on={extracted}>{inv.terms}</Hl></dd>
        <dt>Due date</dt>
        <dd><Hl on={extracted}>{inv.due}</Hl></dd>
        <dt>Your PO</dt>
        <dd><Hl on={extracted}>{inv.po}</Hl></dd>
      </dl>
      <table>
        <thead>
          <tr>
            <th>Item</th>
            <th>Qty</th>
            <th>Unit</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          <tr className={flagged ? "flagged" : ""}>
            <td>{inv.item}</td>
            <td><Hl on={extracted}>{inv.qty}</Hl></td>
            <td><Hl on={extracted}>{money(inv.unit)}</Hl></td>
            <td><Hl on={extracted}>{money(d.subtotal)}</Hl></td>
          </tr>
        </tbody>
      </table>
      <div className="totals">
        <span>Subtotal</span>
        <span>{money(d.subtotal)}</span>
        <span>Tax (15%)</span>
        <span><Hl on={extracted}>{money(d.tax)}</Hl></span>
        <span className="grand">Total</span>
        <span className="grand"><Hl on={extracted}>{money(d.total)}</Hl></span>
      </div>
    </div>
  );
}

function StepBody({ i, sc, d, decision, onDecide }) {
  const inv = sc.invoice;

  if (i === 0) {
    return (
      <dl className="io-kv">
        <dt>From</dt><dd>{sc.email.from}</dd>
        <dt>Subject</dt><dd>{sc.email.subject}</dd>
        <dt>Received</dt><dd>{sc.email.received}</dd>
        <dt>Attachment</dt><dd>{sc.email.attachment}</dd>
      </dl>
    );
  }

  if (i === 1) {
    const f = fieldsOf(sc);
    return (
      <>
        <dl className="io-kv two">
          {f.map(([k, v]) => (
            <React.Fragment key={k}>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </React.Fragment>
          ))}
        </dl>
        <p className="io-hint" style={{ marginTop: 12 }}>
          Highlighted on the invoice at left: each value was read from the document.
        </p>
      </>
    );
  }

  if (i === 2) {
    return (
      <ul className="io-checks">
        {CHECKS.map((c) => (
          <li key={c}>
            <span className="io-tick" aria-hidden="true">✓</span>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    );
  }

  if (i === 3) {
    const poTotal = d.poTotal;
    const invQtyBad = d.mismatch;
    return (
      <>
        <table className="io-match">
          <thead>
            <tr>
              <th></th>
              <th>Invoice</th>
              <th>PO {inv.po}</th>
              <th>Receipt {sc.grn.number}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Quantity</td>
              <td className={invQtyBad ? "flag" : ""}>{inv.qty}</td>
              <td>{sc.po.qty}</td>
              <td>{sc.grn.qty}</td>
            </tr>
            <tr>
              <td>Unit price</td>
              <td>{money(inv.unit)}</td>
              <td>{money(sc.po.unit)}</td>
              <td className="na">n/a</td>
            </tr>
            <tr>
              <td>Line total</td>
              <td className={invQtyBad ? "flag" : ""}>{money(d.subtotal)}</td>
              <td>{money(poTotal)}</td>
              <td className="na">n/a</td>
            </tr>
          </tbody>
        </table>
        <p className="io-rule">
          Rules applied: invoice quantity must not exceed goods received, and the unit price must equal the PO price.
        </p>
        {d.mismatch ? (
          <div className="io-verdict bad">
            The invoice bills {d.overUnits} units ({money(d.overAmount)} before tax) more than the PO and the receipt support.
          </div>
        ) : (
          <div className="io-verdict ok">Invoice, PO and receipt agree on quantity and price.</div>
        )}
      </>
    );
  }

  if (i === 4) {
    return (
      <>
        {d.mismatch ? (
          <p>
            Alvryn stopped here instead of guessing. The invoice bills {inv.qty} units but only {sc.grn.qty} were
            received. It has been sent to <strong>Purchasing</strong> with the comparison above. Choose what the
            reviewer does next.
          </p>
        ) : (
          <p>
            Everything matches. The total of {money(d.total)} is under the {money(APPROVAL_LIMIT)} approval limit set
            for this sample workflow, so it goes to the <strong>Finance approver</strong> for a decision.
          </p>
        )}
        {!decision && (
          <>
            <div className="io-decide">
              {sc.decisions.map((opt) => (
                <button key={opt.id} onClick={() => onDecide(opt)}>{opt.label}</button>
              ))}
            </div>
            <p className="io-decide-note">Nothing moves forward until a person decides. Try one.</p>
          </>
        )}
        {decision && <div className="io-result">{decision.result}</div>}
      </>
    );
  }

  const rows = auditOf(sc, d, decision);
  return (
    <ul className="io-log">
      {rows.map(([t, text], idx) => (
        <li key={idx}>
          <time>{t}</time>
          <span>{text}</span>
        </li>
      ))}
    </ul>
  );
}

/* ─── PAGE ────────────────────────────────────────────────────────────────── */
export default function InvoiceOperationsPage() {
  const [scenarioKey, setScenarioKey] = useState("match");
  const [shown, setShown] = useState(0);
  const [running, setRunning] = useState(false);
  const [started, setStarted] = useState(false);
  const [decision, setDecision] = useState(null);
  const demoRef = useRef(null);
  const stepRefs = useRef([]);

  const sc = SCENARIOS[scenarioKey];
  const d = derive(sc);
  const finished = started && shown >= STEP_COUNT && !running;
  const awaiting = started && shown === RESOLVE_INDEX + 1 && !decision;

  useEffect(() => {
    document.title = "Invoice Operations — Alvryn Workforce";
    window.scrollTo(0, 0);
  }, []);

  // Advance one step at a time. Pauses at the approval step until a person decides.
  useEffect(() => {
    if (!running) return;
    if (shown >= STEP_COUNT) {
      setRunning(false);
      return;
    }
    if (shown === RESOLVE_INDEX + 1 && !decision) return;
    const t = setTimeout(() => setShown((s) => s + 1), shown === 0 ? 700 : 1300);
    return () => clearTimeout(t);
  }, [running, shown, decision]);

  // Keep the newest step in view as it appears.
  useEffect(() => {
    if (shown > 0 && stepRefs.current[shown - 1]) {
      stepRefs.current[shown - 1].scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  }, [shown]);

  function start(key) {
    setScenarioKey(key);
    setShown(0);
    setDecision(null);
    setStarted(true);
    setRunning(true);
  }

  function runFromHero() {
    start("match");
    demoRef.current?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  const otherKey = scenarioKey === "match" ? "mismatch" : "match";

  function statusOf(i) {
    if (i < shown) {
      if (i === RESOLVE_INDEX && !decision) return "await";
      if (d.mismatch && (i === MATCH_INDEX || (i === RESOLVE_INDEX && decision))) return "warn";
      return "done";
    }
    if (i === shown && running) return "active";
    return "pending";
  }

  return (
    <div className="io-root">
      <style>{CSS}</style>

      <header className="io-header">
        <a className="io-mark" href="/">Alvryn</a>
        <a className="io-back" href="/">Back to Alvryn Workforce</a>
      </header>

      <section className="io-hero">
        <h1>See how Alvryn handles an invoice, from arrival to approval.</h1>
        <p className="lead">
          Run a sample invoice through intake, checks, matching and approval. There is nothing to sign up for and nothing to upload.
        </p>
        <button className="io-primary" onClick={runFromHero}>Run a sample invoice</button>
        <p className="io-fine">The vendors and figures are fictional. Nothing you do here is stored.</p>
      </section>

      <section className="io-demo" id="demo" ref={demoRef} aria-label="Sample invoice walkthrough">
        <div className="io-demo-bar">
          <div className="io-switch" role="group" aria-label="Choose a sample invoice">
            {Object.entries(SCENARIOS).map(([key, s]) => (
              <button key={key} aria-pressed={scenarioKey === key} onClick={() => start(key)}>
                {s.label}
              </button>
            ))}
          </div>
          {started && (
            <button className="io-replay" onClick={() => start(scenarioKey)}>Run it again</button>
          )}
        </div>

        <div className="io-stage">
          <div className="io-paper-wrap">
            <InvoiceDoc
              sc={sc}
              d={d}
              extracted={started && shown >= 2}
              flagged={started && d.mismatch && shown >= MATCH_INDEX + 1}
            />
            <p className="io-hint">
              This is the sample invoice. It stays here while Alvryn works, and marks what it read and what it flagged.
            </p>
          </div>

          <div className="io-feed" aria-live="polite">
            {!started && (
              <p className="io-idle">
                Press "Run a sample invoice" above, or pick a sample. Each step appears here as Alvryn completes it,
                and the approval step waits for you.
              </p>
            )}

            {started &&
              Array.from({ length: STEP_COUNT }).map((_, i) => {
                const st = statusOf(i);
                return (
                  <div
                    key={i}
                    className={"io-step " + st}
                    ref={(el) => (stepRefs.current[i] = el)}
                  >
                    <div className="io-dot" aria-hidden="true">
                      {st === "active" ? <span className="io-spin" /> : st === "done" ? "✓" : st === "warn" ? "!" : i + 1}
                    </div>
                    <h3>{stepTitle(i, d)}</h3>
                    {st === "active" && <p className="io-working">{stepWorking[i]}</p>}
                    {i < shown && (
                      <div className="io-body">
                        <StepBody
                          i={i}
                          sc={sc}
                          d={d}
                          decision={decision}
                          onDecide={(opt) => setDecision(opt)}
                        />
                      </div>
                    )}
                  </div>
                );
              })}

            {finished && (
              <div className="io-next">
                <p>
                  {d.mismatch
                    ? "That is the same workflow with a problem in it: Alvryn found the difference, held the invoice and left the decision to a person."
                    : "That is the clean path. Now see what happens when an invoice does not match."}
                </p>
                <button className="io-primary" onClick={() => start(otherKey)}>
                  {d.mismatch ? "Run the matching invoice" : "Run the invoice with a mismatch"}
                </button>
                <button className="io-replay" onClick={() => start(scenarioKey)}>Run it again</button>
              </div>
            )}
          </div>
        </div>
      </section>

      <section className="io-section">
        <h2>What Invoice Operations handles</h2>
        <p className="sub">The work that happens around an invoice, not only the reading of it.</p>
        <ul className="io-caps">
          {CAPABILITIES.map(([name, text]) => (
            <li key={name}>
              <strong>{name}</strong>
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </section>

      <section className="io-section io-pilot">
        <h2>Want to see this on your own workflow?</h2>
        <p className="sub">
          You don't need to share confidential company data. We can start with a short pilot on sample or redacted documents, and measure:
        </p>
        <ul>
          {PILOT_MEASURES.map((m) => (
            <li key={m}>{m}</li>
          ))}
        </ul>
        <a className="io-primary" href={PILOT_MAILTO}>Request a pilot</a>
      </section>

      <footer className="io-footer">
        <span>© Alvryn Technologies</span>
        <a href="/">Alvryn Workforce</a>
      </footer>
    </div>
  );
}